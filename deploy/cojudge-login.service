[Unit]
Description=Cojudge persistent login checks
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/cojudge-login.env
ExecStart=/usr/bin/node /opt/cojudge-login/persistent-login.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
