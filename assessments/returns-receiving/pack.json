            {"method":"inspect_units","args":["BOX-235",1,1],"expected":true},
            {"method":"stock_added","args":["wall-lamp","shop"],"expected":0},
            {"method":"refund_due","args":["RA-51"],"expected":6998},
            {"method":"restock","args":["BOX-235","shop",2],"expected":false},
