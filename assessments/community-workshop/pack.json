            {"method":"change_reservation","args":["paper","lee","glue",2],"expected":false},
            {"method":"reservation","args":["paper","lee","glue"],"expected":0},
            {"method":"change_reservation","args":["paper","lee","glue",1],"expected":true},
            {"method":"available","args":["paper","lee"],"expected":0}
          ]
