          {"prompt":"What does the method return when the team is missing?","choices":["None","True","False"],"answer":2},
          {"prompt":"What happens if the owner tries to grant access to themself?","choices":["It returns True and creates another role.","It returns False because the owner already has access.","It replaces the owner with a member."],"answer":1}
        ]
