            {"method":"change_reservation","args":["metal","lee","wire",2],"expected":true},
            {"method":"transact","args":["metal","lee",[["wire",-1],["foil",4]]],"expected":false},
            {"method":"reservation","args":["metal","lee","wire"],"expected":2},
            {"method":"reservation","args":["metal","lee","foil"],"expected":0},
            {"method":"available","args":["metal","lee"],"expected":2}
          ]
        }
      ],
      "hidden": [
