  "title": "Community Workshop",
  "summary": "Run the supply desk for project teams at a shared workshop.",
  "className": "Workshop",
  "starter": "class Workshop:\n    def __init__(self):\n        pass\n\n    def register_team(self, team_id, owner):\n        pass\n\n    def grant_access(self, team_id, actor, person):\n        pass\n\n    def revoke_access(self, team_id, actor, person):\n        pass\n\n    def has_access(self, team_id, person):\n        pass\n",
  "levels": [
    {
      "title": "Team Access",
      "requirements": "Lee leads the clay team. Kim can collect supplies while Lee runs the session. Keep one team record so the desk can check who may act for that team.\n\nA new Workshop has no teams. Each team has one owner, its project lead, and a set of additional members. Team IDs and person IDs are non-empty ASCII strings. Compare them exactly as written. An actor is the person who requests a change.\n\nregister_team(team_id, owner) creates a team with the specified owner and no additional members. Return True on success. If that team ID already exists, return False and keep its owner and members.\n\ngrant_access(team_id, actor, person) adds person as a member and returns True. Return False if the team does not exist, the actor is not its owner, or person already has access. The owner always has access.\n\nrevoke_access(team_id, actor, person) removes an additional member and returns True. Return False if the team does not exist, the actor is not its owner, or person is not an additional member. The owner cannot lose access.\n\nhas_access(team_id, person) returns True if person owns the team or is an additional member. Return False in all other cases. This query does not require an actor. All failed writes leave state unchanged.",
      "visible": [
        {
          "id": "grant-and-revoke",
          "kind": "requirements",
          "steps": [
            {"method":"register_team","args":["clay","lee"],"expected":true},
            {"method":"has_access","args":["clay","lee"],"expected":true},
            {"method":"has_access","args":["clay","kim"],"expected":false},
            {"method":"grant_access","args":["clay","lee","kim"],"expected":true},
            {"method":"has_access","args":["clay","kim"],"expected":true},
            {"method":"revoke_access","args":["clay","lee","kim"],"expected":true},
            {"method":"has_access","args":["clay","kim"],"expected":false}
          ]
        },
        {
          "id": "only-owner-changes-membership",
          "kind": "validation",
          "steps": [
            {"method":"register_team","args":["paper","lee"],"expected":true},
            {"method":"grant_access","args":["paper","lee","kim"],"expected":true},
            {"method":"grant_access","args":["paper","kim","nia"],"expected":false},
            {"method":"revoke_access","args":["paper","kim","kim"],"expected":false},
            {"method":"has_access","args":["paper","kim"],"expected":true},
            {"method":"has_access","args":["paper","nia"],"expected":false}
          ]
        }
      ],
