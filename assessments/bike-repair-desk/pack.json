            {"method":"set_part","args":["C-104","tube-700x35",1,950],"expected":true},
            {"method":"set_part","args":["C-104","rim-tape-700",1,450],"expected":true},
            {"method":"view","args":["C-104"],"expected":{"bike":"Marin commuter","shop":"canal","status":"estimate","total_cents":4200,"parts":[["rim-tape-700",1,450],["tube-700x35",1,950]]}}
          ]
        },
